# Dependency cooldown — supply-chain defense.
#
# Malicious npm versions are typically published and yanked within hours to
# days (chalk/debug, ua-parser-js, event-stream). A minimum release age filters
# out that entire smash-and-grab class: npm resolves to the newest version at
# least N days old and silently skips anything newer.
#
# This constrains RESOLUTION, which happens on `npm install`, `npm update` and
# `npm audit fix`. CI runs `npm ci` against the committed lockfile and resolves
# nothing, so this setting is intentionally inert there -- that is correct, not
# an omission. Requires npm >= 11.10.0; older npm ignores the key.
#
# Escape hatch for a genuinely urgent fix:
#   npm i --min-release-age 0 <pkg>@<version>
min-release-age=7

# Block install lifecycle scripts.
#
# postinstall is the primary execution vector in npm compromises: install the
# package, the script runs, credentials exfiltrate. Blocking it defuses the
# common payload even when a malicious version does reach the tree.
#
# Before relying on this, list the packages in your tree that declare install
# scripts (`npm query ':attr(scripts, [postinstall])'`) and confirm each one
# still works without them, or run that package's build step explicitly. Native
# addons are the usual case.
ignore-scripts=true
