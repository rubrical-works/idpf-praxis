{
  "$schema": "trigger-flag-allowlist-schema.json",
  "version": 1,
  "commands": {
    "/review-issue": [
      "--with",
      "--mode",
      "--force",
      "--prior-art",
      "--without"
    ],
    "/bug": [
      "--assignee"
    ],
    "/enhancement": [
      "--assignee"
    ],
    "/proposal": [
      "--assignee",
      {
        "flag": "--update",
        "attach": "rest-of-line"
      }
    ],
    "/work": [
      { "flag": "--assign", "attach": "none" },
      { "flag": "--nonstop", "attach": "none" },
      { "flag": "--wait", "attach": "none" },
      { "flag": "--reopen", "attach": "none" },
      { "flag": "--concurrent", "attach": "none" },
      "--agents",
      { "flag": "--no-review", "attach": "none" }
    ]
  }
}
