{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-repairs-schema.json",
  "title": "Review Repairs",
  "description": "Schema for review-repairs.json — repairable review criteria keyed by criterion id (#3544). Every entry names the issue types and review modes it applies to; a repair outside them is never offered.",
  "type": "object",
  "required": ["version", "repairs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "_meta": { "type": "object", "description": "Provenance. Not read at runtime.", "additionalProperties": true },
    "repairs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["kind", "preFinalize", "types", "modes", "description"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["deployment-impact", "depends-on-line", "priority", "model-authored", "test-ac"] },
        "preFinalize": { "type": "boolean" },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["bug", "enhancement", "story", "epic", "generic"] }
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["solo", "team", "enterprise"] }
        },
        "env": { "enum": ["dev"] },
        "description": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "kind": { "const": "model-authored" } } },
      "then": { "properties": { "preFinalize": { "const": false } } }
    }
  }
}
