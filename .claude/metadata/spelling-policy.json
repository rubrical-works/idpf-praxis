{
  "$schema": "./spelling-policy-schema.json",
  "version": 1,
  "_meta": {
    "description": "Framework-authored text uses American English (#2978). Whole-word British -> American pairs, the spans that must keep their spelling because they are external names, and the paths the regression guard does not scan. The single word map both the guard (tests/reference/american-spelling.test.js) and minimize-helper.js spell-carry read.",
    "consumers": [
      "tests/reference/american-spelling.test.js",
      ".claude/scripts/framework/minimize-helper.js spell-carry"
    ],
    "policy": ".claude/rules/01-anti-hallucination.md (source: Assistant/Anti-Hallucination-Rules-for-Framework-Development.md)",
    "matching": "Whole word, case-insensitive; a match adjacent to a letter, digit or underscore is not a word, so camelCase and snake_case identifiers are not matched. Case is preserved on replacement: lower, Capitalized and UPPER. Any other casing is reported rather than guessed.",
    "expansion": "Every iseStems entry expands with every iseSuffixes pair (stem+british -> stem+american), except iseExceptions. Only stems whose -ize form is standard American spelling are listed: words spelled -ise in both (advise, revise, exercise, promise, surprise, expertise, compromise, …) are deliberately absent, and so is analyses, which is also the plural of analysis.",
    "identifiers": "Contract identifiers renamed by #2978. Exact, case-sensitive tokens; the guard reports any reappearance and spell-carry carries them like words."
  },
  "language": "en-US",
