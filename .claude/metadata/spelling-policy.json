  "allowlist": [
    {
      "pattern": "https?://[^\\s)>\\]\"'`]+",
      "reason": "URLs are external addresses; a path segment such as ico.org.uk/for-organisations must not be respelled."
    },
    {
      "pattern": "\\bMonoBehaviour\\b",
      "reason": "Unity API type name."
    },
    {
      "pattern": "\\baria-labelledby\\b",
      "reason": "HTML attribute name."
    },
    {
      "pattern": "\\bBlue Grey\\b",
      "reason": "Material Design palette name (drawio-generation palette)."
    },
    {
      "pattern": "\\bcatalogue(?=, carts\\b)",
      "reason": "Service name in the Sock Shop microservices demo (Docs/04-Suitability/Reference-Microservices-Repos.md)."
    },
    {
      "pattern": "\\b\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]*(?:parameterisation|behaviour)\\.md\\b",
      "reason": "Record filenames under Construction/Design-Decisions/ keep the spelling they were committed with; a reference to one must still resolve."
    },
    {
      "pattern": "Unrecognised argument --bogus",
      "reason": "Recorded expected output of charter-testing-audit.js in the v0.103.0 release test plan; a record keeps what the tool printed then."
    },
    {
      "pattern": "\\[x\\] catalogued|`catalogued` with `checked:true`",
      "reason": "Recorded command input and expected output in the v0.97.0 release test plan (G2)."
    },
    {
      "pattern": "How to Organise Feature Files",
      "reason": "Title of a third-party page (Cucumber blog), quoted as written."
    },
    {
      "pattern": "\"british\": \"[A-Za-z]+\"",
      "reason": "The word a spell-carry replaced, recorded in minimize-targets.json spellCarry substitutions (#2984). A British spelling is the value's whole purpose: the verifier applies these in reverse to reconstruct the pre-carry file. Scoped to the JSON field, so ordinary prose in that file is still guarded."
    }
  ],
  "excludePaths": [
    {
      "glob": ".claude/metadata/spelling-policy.json",
      "reason": "The word list itself."
    },
    {
      "glob": ".claude/skills/**",
      "reason": "Imported from idpf-praxis-skills; a local fix is reverted by /fw-import-skills. Handed off on #2978."
    },
    {
      "glob": "tests/fixtures/issue-bodies/**",
      "reason": "Captured GitHub issue bodies; issue text on GitHub is out of scope for #2978, and a fixture must match what it captured."
    },
    {
      "glob": "tests/reference/american-spelling.test.js",
      "reason": "The guard asserts on British spellings by design."
    },
    {
      "glob": "tests/scripts/framework/spelling-policy.test.js",
      "reason": "The loader tests exercise British spellings by design."
    },
    {
      "glob": "tests/scripts/framework/spell-carry-verify.test.js",
      "reason": "The independent carry check exercises British spellings by design."
    },
    {
      "glob": "tests/scripts/framework/minimize-spell-carry.test.js",
      "reason": "The carry tests feed British spellings through the carry by design."
    },
    {
      "glob": "node_modules/**",
      "reason": "Third-party code."
    },
    {
      "glob": "package-lock.json",
      "reason": "Third-party package metadata."
    }
  ]
