{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "charter-enforcement-schema.json",
  "title": "Charter Enforcement",
  "description": "Contract for charter-enforcement.json (#3001): the checkpoints, alignment categories, resolution options, exclusions and opt-out that the always-on 04-charter-enforcement rule used to state. Read by .claude/scripts/shared/lib/charter-scope.js and by the commands that call it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checkpoints", "depths", "alignment", "resolutionOptions", "expansionFlow", "exclusions", "optOut"],
  "$defs": {
    "depth": { "type": "string", "enum": ["full", "summary", "quick"] },
    "category": { "type": "string", "enum": ["aligned", "possibly-misaligned", "conflicts"] }
  },
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "checkpoints": {
      "type": "object",
      "description": "Keyed by command name without the leading slash.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["depth"],
        "properties": {
          "depth": { "$ref": "#/$defs/depth" },
          "checks": { "type": "string" }
        }
      }
    },
    "depths": {
      "type": "object",
      "description": "Which charter lists each depth compares against.",
      "additionalProperties": false,
      "required": ["full", "summary", "quick"],
      "patternProperties": {
        "^(full|summary|quick)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lists", "loads"],
          "properties": {
            "lists": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["inScope", "outOfScope", "currentFocus"] }
            },
            "loads": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aligned", "possibly-misaligned", "conflicts"],
      "patternProperties": {
        "^(aligned|possibly-misaligned|conflicts)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "action", "ask"],
          "properties": {
            "description": { "type": "string" },
            "action": { "type": "string" },
            "ask": { "type": "boolean" }
          }
        }
      }
    },
    "resolutionOptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "action"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    },
    "expansionFlow": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "exclusions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "optOut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "perSession", "quietMode"],
      "properties": {
        "file": { "type": "string" },
        "perSession": { "type": "string" },
        "quietMode": { "type": "string" }
      }
    }
  }
}
