{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "charter-contract-schema.json",
  "title": "Charter Contract",
  "description": "Contract for charter-contract.json (#3481): what a valid CHARTER.md is — its title, required sections, Key Entities table, the unfilled-placeholder rule and the shape thresholds — with verdict cases any implementation of the placeholder rule must reproduce. Read by .claude/scripts/shared/lib/charter-template.js, lib/charter-shape.js and charter-entities.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "requiredSections", "retiredSections", "keyEntities", "storedValues", "placeholder", "shapeThresholds", "cases"],
  "$defs": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1, "description": "ECMAScript regular expression source." },
        "flags": { "type": "string", "pattern": "^[imsu]*$", "description": "ECMAScript flags. Never 'g': a global regex keeps lastIndex between test() calls." }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "form", "role"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1, "description": "Regular expression line 1 of CHARTER.md must match." },
        "form": { "type": "string", "description": "The title as written in the /charter spec, {name} standing for the project name." },
        "role": { "const": "generation", "description": "The title's role (#3515): a generation requirement only — what /charter writes and line 1 must match — never an input to the filled/unfilled decision, which the placeholder rule alone makes." },
        "description": { "type": "string", "description": "The stated role, in prose, for a downstream consumer." }
      }
    },
    "requiredSections": {
      "type": "array",
      "description": "Section headings a charter must carry, in target order.",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "optionalSections": {
      "type": "array",
      "description": "Sections /charter writes when they have content and a charter may carry, beyond requiredSections (#3643).",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "retiredSections": {
      "type": "array",
      "description": "Sections an earlier contract version required or allowed and this one removes; a charter carrying one does not conform (#3643).",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "storedValues": {
      "type": "object",
      "description": "What counts as a stored count or version, which a charter never holds (#3643).",
      "additionalProperties": false,
      "required": ["keyEntities", "techStack", "prose", "never"],
      "properties": {
        "description": { "type": "string" },
        "keyEntities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["countColumn", "numberOnlyCell"],
          "properties": {
            "countColumn": { "type": "string", "minLength": 1, "description": "A Key Entities column with this header (case-insensitive) is a stored count." },
            "numberOnlyCell": { "$ref": "#/$defs/pattern" },
            "description": { "type": "string" }
          }
        },
        "techStack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "parenthesizedQuantity"],
          "properties": {
            "version": { "$ref": "#/$defs/pattern" },
            "parenthesizedQuantity": { "$ref": "#/$defs/pattern" },
            "description": { "type": "string" }
          }
        },
        "prose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sections", "countedNoun"],
          "properties": {
            "sections": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "countedNoun": { "$ref": "#/$defs/pattern" },
            "description": { "type": "string" }
          }
        },
        "never": {
          "type": "object",
          "additionalProperties": false,
          "required": ["excludedSections"],
          "properties": {
            "excludedSections": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "description": { "type": "string" }
          }
        }
      }
    },
    "keyEntities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "tableHeader"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "description": "Heading text of the Key Entities section, without the leading hashes." },
        "tableHeader": {
          "type": "array",
          "description": "Column names of the Key Entities table, in order (#2379).",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "todoMarker", "codeExclusion"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1, "description": "Regular expression source matching one unfilled placeholder. ANY match outside code makes the charter a template." },
        "todoMarker": { "$ref": "#/$defs/pattern" },
        "codeExclusion": {
          "type": "object",
          "description": "Text removed before matching: braces inside code are literal content, never placeholders. Code stripping is an algorithm, not a regex; cases[] is what binds two implementations of it.",
          "additionalProperties": false,
          "required": ["lineEndings", "fenceChars", "fenceMinLength", "fenceClose", "inlineCodeChar", "inlineCode"],
          "properties": {
            "lineEndings": { "type": "string", "enum": ["crlf-to-lf"] },
            "fenceChars": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1 } },
            "fenceMinLength": { "type": "integer", "minimum": 1 },
            "fenceClose": { "type": "string", "description": "When a fence closes." },
            "inlineCodeChar": { "type": "string", "minLength": 1, "maxLength": 1 },
            "inlineCode": { "type": "string", "description": "What an inline code span is." }
          }
        }
      }
    },
    "shapeThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inScopeBulletWords"],
      "properties": {
        "inScopeBulletWords": { "type": "integer", "minimum": 1, "description": "An In Scope bullet longer than this many words is a shape finding." }
      }
    },
    "cases": {
      "type": "array",
      "description": "Conformance suite: charter fragments with the verdict every implementation of the placeholder rule must return.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "content", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["template", "placeholders"],
            "properties": {
              "template": { "type": "boolean" },
              "placeholders": { "type": "array", "items": { "type": "string" } },
              "shape": {
                "type": "object",
                "description": "The shape verdict (#3643): required sections missing, retired sections present, and stored values in document order. Present only on cases that pin the shape rule.",
                "additionalProperties": false,
                "required": ["conforms", "missingSections", "retiredSections", "storedValues"],
                "properties": {
                  "conforms": { "type": "boolean" },
                  "missingSections": { "type": "array", "items": { "type": "string" } },
                  "retiredSections": { "type": "array", "items": { "type": "string" } },
                  "storedValues": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["section", "kind", "text"],
                      "properties": {
                        "section": { "type": "string" },
                        "kind": { "enum": ["count-column", "number-cell", "version", "parenthesized-quantity", "counted-noun"] },
                        "text": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
