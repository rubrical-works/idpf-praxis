{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-state-gate-actions-schema.json",
  "title": "Review-State Gate Actions",
  "description": "Schema for review-state-gate-actions.json — the state x run-shape action matrix of the /work Step 3 Review-State Gate (#2577), externalized in #2765. Since #3537 there is no warn-proceed action: an unreviewed issue is reviewed first (review), and only the waiver flag lets a gated state proceed. Every state must map every shape to an action; a state missing a shape would read as 'no rule', which the gate would then have to invent.",
  "type": "object",
  "required": ["version", "states", "shapes", "actions", "neverPrompt", "waiver", "actionMeanings"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "_meta": { "type": "object", "description": "Provenance. Not read at runtime.", "additionalProperties": true },
    "states": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["never-reviewed", "findings-pending", "reviewed-clean", "stale-reviewed", "indeterminate"] }
    },
    "shapes": {
      "type": "object",
      "required": ["single", "batch", "nonstop"],
      "additionalProperties": false,
      "properties": {
        "single": { "type": "string", "minLength": 1 },
        "batch": { "type": "string", "minLength": 1 },
        "nonstop": { "type": "string", "minLength": 1 }
      }
    },
    "actions": {
      "type": "object",
      "required": ["never-reviewed", "findings-pending", "reviewed-clean", "stale-reviewed", "indeterminate"],
      "additionalProperties": false,
      "properties": {
        "never-reviewed": { "$ref": "#/$defs/shapeActions" },
        "findings-pending": { "$ref": "#/$defs/shapeActions" },
        "reviewed-clean": { "$ref": "#/$defs/shapeActions" },
        "stale-reviewed": { "$ref": "#/$defs/shapeActions" },
        "indeterminate": { "$ref": "#/$defs/shapeActions" }
      }
    },
    "neverPrompt": {
      "type": "array",
      "description": "States that never prompt in any mode. The rule states this in prose as well; the two must agree.",
      "items": { "enum": ["never-reviewed", "findings-pending", "reviewed-clean", "stale-reviewed", "indeterminate"] },
      "uniqueItems": true
    },
    "waiver": {
      "type": "object",
      "description": "The /work flag that waives the clean-review requirement (#3537), and the states it waives. Without it no gated state proceeds to work.",
      "required": ["flag", "waives"],
      "additionalProperties": false,
      "properties": {
        "flag": { "type": "string", "pattern": "^--[a-z][a-z-]*$" },
        "waives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["never-reviewed", "findings-pending", "stale-reviewed"] }
        }
      }
    },
    "actionMeanings": {
      "type": "object",
      "required": ["review", "stop", "halt", "proceed"],
      "additionalProperties": false,
      "properties": {
        "review": { "type": "string", "minLength": 1 },
        "stop": { "type": "string", "minLength": 1 },
        "halt": { "type": "string", "minLength": 1 },
        "proceed": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "shapeActions": {
      "type": "object",
      "required": ["single", "batch", "nonstop"],
      "additionalProperties": false,
      "properties": {
        "single": { "$ref": "#/$defs/action" },
        "batch": { "$ref": "#/$defs/action" },
        "nonstop": { "$ref": "#/$defs/action" }
      }
    },
    "action": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["review", "stop", "halt", "proceed"] },
        "offer": { "type": "string", "pattern": "^/(review-issue|resolve-review) #\\$ISSUE$" }
      },
      "if": { "properties": { "action": { "const": "stop" } } },
      "then": { "required": ["offer"] }
    }
  }
}
