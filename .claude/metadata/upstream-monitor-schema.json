{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upstream-monitor-schema.json",
  "title": "Upstream Push Monitor",
  "description": "Scheduling and surfacing contract for the background upstream-push monitor (#2667). The monitor is a scheduler around branch-sync-check.js plus a surfacing contract — it never fetches, times out, or derives status itself.",
  "type": "object",
  "required": [
    "version",
    "host",
    "polling",
    "emission",
    "pushWindow",
    "surfacing",
    "unverifiedFetch"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "_meta": {
      "type": "object",
      "description": "Provenance. Not read at runtime.",
      "additionalProperties": true
    },
    "host": {
      "type": "object",
      "description": "Runtime host settled by the AC-1 spike.",
      "required": [
        "mechanism",
        "persistent",
        "diesWithSession",
        "compactionSurvival"
      ],
      "additionalProperties": false,
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "persistent": {
          "type": "boolean"
        },
        "diesWithSession": {
          "type": "boolean"
        },
        "compactionSurvival": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "not-supported"
          ],
          "description": "Recorded as an explicit value so 'unverified' can never be read as 'works'."
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "polling": {
      "type": "object",
      "required": [
        "defaultIntervalSeconds",
        "floorSeconds",
        "fetchBoundSeconds",
        "backoff"
      ],
      "additionalProperties": false,
      "properties": {
        "defaultIntervalSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "floorSeconds": {
          "type": "integer",
          "minimum": 60,
          "description": "Hard floor. Backoff may never produce an interval below this."
        },
        "fetchBoundSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "backoff": {
          "type": "object",
          "required": [
            "strategy",
            "factor",
            "maxIntervalSeconds",
            "resetOn"
          ],
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "multiplicative"
              ]
            },
            "factor": {
              "type": "number",
              "minimum": 1
            },
            "maxIntervalSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "resetOn": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string"
            }
          }
        },
        "floorRationale": {
          "type": "string"
        },
        "fetchBoundRationale": {
          "type": "string"
        }
      }
    },
    "emission": {
      "type": "object",
      "description": "What the monitor prints. The host stops a monitor that emits too much, so this is a correctness contract, not a preference.",
      "required": [
        "emitPerPoll",
        "emitOn",
        "transitionKey",
        "alwaysEmitFirstResult"
      ],
      "additionalProperties": false,
      "properties": {
        "emitPerPoll": {
          "const": false,
          "description": "Pinned false. A per-poll emitter is automatically stopped by the host, which disarms the feature silently."
        },
        "emitOn": {
          "type": "string",
          "enum": [
            "transition"
          ]
        },
        "transitionKey": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Fields whose change constitutes a transition worth an event."
        },
        "alwaysEmitFirstResult": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        },
        "firstResultRationale": {
          "type": "string"
        }
      }
    },
    "pushWindow": {
      "type": "object",
      "description": "AC-8. The interval during which a fetch would move a ref /done has pinned.",
      "required": [
        "skipWhileGlob",
        "reportSkip"
      ],
      "additionalProperties": false,
      "properties": {
        "skipWhileGlob": {
          "type": "string",
          "minLength": 1
        },
        "reportSkip": {
          "const": true,
          "description": "Pinned true. A silent skip is indistinguishable from 'no upstream activity', and a crashed /done leaves the file behind indefinitely."
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "surfacing": {
      "type": "object",
      "required": [
        "inheritsFrom",
        "restatePerStateContract",
        "mutatesWorkingTree",
        "autoRemediation"
      ],
      "additionalProperties": false,
      "properties": {
        "inheritsFrom": {
          "type": "string",
          "minLength": 1
        },
        "restatePerStateContract": {
          "const": false,
          "description": "Pinned false. Two surfaces restating one per-state contract will disagree; #2668 has already reopened one of those states."
        },
        "mutatesWorkingTree": {
          "const": false
        },
        "autoRemediation": {
          "const": "none"
        },
        "rationale": {
          "type": "string"
        },
        "divergedRecovery": {
          "type": "object",
          "description": "Wording emitted after status and counts when the branch has diverged (#2719, Option C). NOT a restatement of the per-state contract — rule 03 owns which state gets what; this holds the string the monitor renders, exactly as unverifiedFetch.wording does for the #2687 caveat.",
          "required": [
            "wording"
          ],
          "additionalProperties": false,
          "properties": {
            "wording": {
              "type": "string",
              "minLength": 1
            },
            "namesGitCommand": {
              "const": false,
              "description": "Pinned false. Naming a recovery path is not a history rewrite; naming git rebase or git merge would commit the user to one mid-session, unprompted — the #2518 sequencing constraint, which binds harder here than at startup because the interruption is unsolicited."
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    },
    "unverifiedFetch": {
      "type": "object",
      "required": [
        "neverReportAs",
        "wording"
      ],
      "additionalProperties": false,
      "properties": {
        "neverReportAs": {
          "type": "string",
          "minLength": 1
        },
        "wording": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  }
}
